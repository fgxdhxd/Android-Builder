[
  {
    "kernelSource": {
      "name": "Hyper",
      "repo": "https://github.com/fgxdhxd/crux-marisa",
      "branch": "1",
      "device": "crux",
      "defconfig": "crux_defconfig"
    },
    "enableCcache": false,
    "enableKernelSU": false,
    "enableKernelSUExtPatch": false,
    "enableLXC": false,
  "toolchains": [
    {
      "repo": "https://github.com/kdrag0n/proton-clang",
      "branch": "master",
      "name": "tools",
      "binaryEnv": ["bin"]
    }
  ],
  "params": {
    "ARCH": "arm64",
    "CC": "tools/bin/clang",
    "externalCommands": {
      "CROSS_COMPILE": "aarch64-linux-gnu-",
      "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
      "CROSS_COMPILE_COMPAT": "",
      "CLANG_TRIPLE": "aarch64-linux-gnu-",
      "AR": "tools/bin/llvm-ar",
      "HOSTCC": "gcc",
      "HOSTCXX": "tools/bin/clang++",
      "NM": "tools/bin/llvm-nm",
      "OBJCOPY": "tools/bin/llvm-objcopy",
      "OBJDUMP": "tools/bin/llvm-objdump",
      "STRIP": "tools/bin/llvm-strip",
      "LD": "tools/bin/ld.lld",
      "DTC_EXT": "tools/bin/dtc"
      }
    },
    "AnyKernel3": {
      "use": false,
      "release": true,
      "custom":{
        "repo": "https://github.com/wjy1065676928/AnyKernel3",
        "branch": "master"
      }
    }
}
]
